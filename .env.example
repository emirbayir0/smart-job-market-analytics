# Gemini API Key (Gemini API ile Beceri Çıkarma Servisi)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Konfigürasyonu (Anlık Bildirimler İçin)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Veritabanı Yapılandırması (Varsayılan: SQLite)
DATABASE_URL=sqlite:///data/market_tracker.db

# Veri Kazıma Periyodu (Saat cinsinden)
SCRAPE_INTERVAL_HOURS=6
